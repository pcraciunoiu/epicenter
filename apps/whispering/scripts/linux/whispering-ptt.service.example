[Unit]
Description=Whispering PTT listener (Moonlander F14)
After=graphical-session.target

[Service]
# Auto-detects the Moonlander PTT node (generic interface, often event4).
# Override with --device /dev/input/eventN if needed.
# Do not use --grab — it blocks all Moonlander typing.
ExecStart=%h/.local/bin/whispering-ptt-listener.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
