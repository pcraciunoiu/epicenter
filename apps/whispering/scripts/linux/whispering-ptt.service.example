[Unit]
Description=Whispering Linux shortcut listener
After=graphical-session.target

[Service]
# Configure keys/device in ~/.config/whispering/ptt.conf
# (see scripts/linux/whispering-ptt.conf.example).
# Do not use --grab — it blocks all Moonlander typing.
ExecStart=%h/.local/bin/whispering-ptt-listener.py --config %h/.config/whispering/ptt.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
