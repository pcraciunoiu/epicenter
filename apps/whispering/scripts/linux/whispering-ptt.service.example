[Unit]
Description=Whispering Linux shortcut listener (PTT F14, toggle F13)
After=graphical-session.target

[Service]
Environment=WHISPERING_PTT_KEY=F14
Environment=WHISPERING_TOGGLE_KEY=F13
# Auto-detects the Moonlander PTT node (generic interface, often event4).
# Override with --device /dev/input/eventN if needed.
# Do not use --grab — it blocks all Moonlander typing.
ExecStart=%h/.local/bin/whispering-ptt-listener.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
