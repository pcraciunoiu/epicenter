# Whispering Linux PTT listener config.
# Copy to: ~/.config/whispering/ptt.conf
#
# Omit ptt_key or toggle_key to disable that binding.
# Prefer device_name over device= — /dev/input/eventN can change after replug.

[ptt]
device_name = ZSA Technology Labs Moonlander Mark I
# device = /dev/input/event4

ptt_key = F14
# toggle_key = F15

# whispering = /usr/bin/whispering
